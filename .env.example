# SeedCode authentication backend (Vercel project environment)
# Copy to the Vercel project's Environment Variables. Never commit real values
# and never expose any of these to browser JavaScript.

# Public origin of this deployment. Must match the GitHub OAuth callback base:
#   ${PUBLIC_BASE_URL}/api/auth/oauth/callback
PUBLIC_BASE_URL=https://seedcode-web.vercel.app

# GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# Callback URL: https://seedcode-web.vercel.app/api/auth/oauth/callback
# The client secret is server-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user

# Signs the OAuth state / browser-session cookies. At least 32 characters.
AUTH_SESSION_SECRET=

# 32-byte key (base64 or 64 hex characters) for AES-256-GCM encryption of the
# GitHub token while a terminal approval is pending. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=

# Session store. Vercel KV / Upstash Redis REST (production requires one).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash names are accepted as aliases:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Lifetimes in seconds (defaults shown).
AUTH_SESSION_TTL_SECONDS=600
AUTH_APPROVAL_TTL_SECONDS=600
AUTH_CODE_TTL_SECONDS=120
AUTH_POLL_INTERVAL_SECONDS=5

# Local development only. Production refuses the in-memory store.
# AUTH_ALLOW_MEMORY_STORE=1
